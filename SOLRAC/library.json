{
    "name": "SOLRAC",
    "version": "0.1.0",
    "description": "Space Concordia Solid Rocketry Avionics Dual-Bus CAN-FD Library",
    "keywords": [
        "can",
        "canfd",
        "opencyphal",
        "avionics",
        "stm32"
    ],
    "frameworks": [
        "stm32cube",
        "arduino",
        "cmsis"
    ],
    "platforms": [
        "ststm32"
    ],
    "build": {
        "srcDir": ".",
        "includeDir": "inc",
        "srcFilter": [
            "+<src/*>",
            "+<drivers/src/*>",
            "+<dependancies/libcanard/canard.c>",
            "+<dependancies/o1heap/o1heap.c>"
        ],
        "flags": [
            "-Iinc",
            "-Idrivers/inc",
            "-Idsdl_generated",
            "-Idependancies/libcanard",
            "-Idependancies/o1heap"
        ]
    }
}